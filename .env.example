NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SERVER_SIGNING_SECRET=
PRODUCTION_SUPABASE_URL=
# Must match the target environment. Use a dedicated database for previews.
DATABASE_ENVIRONMENT=preview
GROQ_API_KEY=
VOYAGE_API_KEY=
AI_ANSWER_MODEL=openai/gpt-oss-120b
AI_FAST_MODEL=openai/gpt-oss-20b
AI_STRUCTURE_MODEL=openai/gpt-oss-20b
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional OCR service for scanned PDFs (LlamaParse)
LLAMA_CLOUD_API_KEY=
# Production uploads require an authenticated malware scanning endpoint.
FILE_SCAN_URL=
FILE_SCAN_TOKEN=
# Invitation email (Resend). EMAIL_MODE=staging sends only to EMAIL_STAGING_ALLOWLIST (comma-separated) and resend.dev; leave it empty for live.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_MODE=
EMAIL_STAGING_ALLOWLIST=
# Written approval required before enabling automated legal corpus ingestion.
LEGAL_CORPUS_INGEST_ENABLED=false
# Interactive demo at /demo (sample data, no model calls). Set to `on` for local dev and CI; leave unset in production, where every demo route is a 404.
DEMO_MODE=
# Built knowledge base output (manifest.json, corpus.jsonl) read by scripts/ingest-kb.ts.
# Relative to the repo root. Build it with `pnpm --dir kb build` (demo) or `pnpm --dir kb build:prod` (approved only).
KB_DIST_DIR=kb/dist
